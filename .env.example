# Apify API token — enables live LinkedIn scraping in /api/evaluate.
# Without it, /in/aranyabandhu/ falls back to a bundled sample scrape and other
# profiles return an "add a token" note (the card still builds from X + demo).
#
# Get one: https://console.apify.com/settings/integrations
# Local:   copy this file to .env  (or export APIFY_TOKEN=...) before `npm run dev`
# Vercel:  Project → Settings → Environment Variables → add APIFY_TOKEN
APIFY_TOKEN=

# Stripe SECRET key, TEST MODE ONLY (starts with sk_test_) — powers Billing →
# "Add budget" → Checkout in /api/create-checkout-session + /api/checkout-session.
# No stripe npm package is used (this repo has zero dependencies); it's plain
# REST calls, see api/_lib/stripe.mjs.
#
# Get one: Stripe Dashboard → make sure "Test mode" is ON (top right) →
#          Developers → API keys → Secret key
# Local:   copy this file to .env before `npm run dev`
# Vercel:  Project → Settings → Environment Variables → add STRIPE_SECRET_KEY
# Test card for Checkout: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=

# Fixed Stripe Price IDs (Dashboard → Product catalog → Add product, in TEST
# mode) — used by /api/create-checkout-session when the client sends
# { plan: "<key>" } instead of an ad-hoc amount. See PRICE_CATALOG in
# api/_lib/stripe.mjs. mode must match how the Price was created: the topups
# are one-time, Starter/Pro/Business are recurring (monthly) — mismatching
# this makes Stripe reject the Checkout Session outright.
STRIPE_PRICE_TOPUP_100=
STRIPE_PRICE_TOPUP_200=
STRIPE_PRICE_TOPUP_300=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Webhook signing secret (Dashboard → Developers → Webhooks → your endpoint
# → Signing secret, starts with whsec_). Verifies POST /api/webhooks/stripe
# really came from Stripe (pure HMAC, api/_lib/stripe-webhook.mjs — doesn't
# need STRIPE_SECRET_KEY). Local testing: `stripe listen --forward-to
# localhost:5173/api/webhooks/stripe` (Stripe CLI) prints a webhook secret
# for that session — use that one locally, not necessarily the dashboard's.
STRIPE_WEBHOOK_SECRET=

# OpenAI API key — powers the floating chat widget (naano-chat-widget.js):
# POST /api/ask (api/_lib/rag.mjs) embeds the query and the site's own
# indexed content (api/_lib/rag-index.json), then generates an answer
# strictly grounded in whatever was retrieved. Without a key, /api/ask
# returns 503 rather than crashing — the rest of the site is unaffected.
#
# Get one: https://platform.openai.com/api-keys
# Local:   copy this file to .env before `npm run dev`
# Vercel:  Project → Settings → Environment Variables → add OPENAI_API_KEY
# Never paste a real key into a commit, a shell command, or a chat — set it
# as an environment variable only. If one is ever exposed, rotate it
# (revoke + regenerate on the OpenAI dashboard) rather than keep using it.
OPENAI_API_KEY=
